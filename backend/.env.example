# ====================================================
# BumilFit Backend - Environment Variables Template
# Salin file ini ke '.env' dan isi dengan nilai asli
# JANGAN commit file .env ke git!
# ====================================================

# === Database (Neon PostgreSQL) ===
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=verify-full&channel_binding=require"

# === Server ===
PORT=5000
# Set ke 'production' di hosting (Render otomatis set ini)
NODE_ENV=production

# === URL Frontend (untuk CORS) ===
# Pisahkan beberapa domain dengan koma:
# FRONTEND_URL=https://bumilfit.vercel.app,http://localhost:5173
FRONTEND_URL=https://bumilfit.vercel.app

# === JWT Secret (WAJIB diisi string acak panjang!) ===
# Generate dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="GANTI_DENGAN_STRING_ACAK_PANJANG_MINIMAL_32_KARAKTER"

# === Google Gemini AI ===
GEMINI_API_KEY="your-gemini-api-key-here"

# === Google reCAPTCHA v2 ===
RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key"

# === Nodemailer (Gmail App Password) ===
GOOGLE_APP_EMAIL="bumilfit@gmail.com"
GOOGLE_APP_PASSKEY="xxxx xxxx xxxx xxxx"

# === Google OAuth ===
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# === WhatsApp Gateway Admin ===
WHATSAPP_ADMIN_EMAIL="bumilfit@gmail.com"
WHATSAPP_ADMIN_PASSWORD="your-admin-password"
WHATSAPP_SESSION_PATH="./whatsapp_session"
