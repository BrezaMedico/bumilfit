# Database PostgreSQL (Neon DB Pooler)
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=verify-full&channel_binding=require"
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://bumilfit.vercel.app
JWT_SECRET="super-secret-key-change-this-in-production"

# AI Integration
GEMINI_API_KEY="your-gemini-api-key"

# Google reCAPTCHA v2 (Secret Key)
RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key"

# Google SMTP Nodemailer (Kirim OTP Email)
GOOGLE_APP_EMAIL="bumilfit@gmail.com"
GOOGLE_APP_PASSKEY="your-google-app-password-16-char"
GOOGLE_CLIENT_ID="your-google-oauth-client-id"

# WhatsApp Gateway Service
WHATSAPP_ADMIN_EMAIL="bumilfit@gmail.com"
WHATSAPP_ADMIN_PASSWORD="your-strong-password"
WHATSAPP_SESSION_PATH="./whatsapp_session"
