generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  IBU_HAMIL
  DOKTER
  WHATSAPP_ADMIN
}

enum Keparahan {
  RINGAN
  SEDANG
  BERAT
}

model User {
  id          String           @id @default(uuid())
  email       String           @unique
  password    String?
  role        Role
  authProvider String          @default("LOCAL")
  isVerified  Boolean          @default(false)
  lastActiveAt        DateTime         @default(now())
  reminderAutoPaused  Boolean          @default(false)
  profilIbu           ProfilIbuHamil?
  keluhanLogs         KeluhanLog[]
  otp                 OtpVerification?
  posts               Post[]
  comments            Comment[]
  likes               Like[]
  todos               UserTodo[]
  subscription        Subscription?
  orders              Order[]
  createdAt           DateTime         @default(now())
}

model ProfilIbuHamil {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  namaIbu             String
  namaAnak            String?
  usiaKehamilanMinggu Int
  usiaKehamilanHari   Int      @default(0)
  nomorWhatsapp       String
  genderAnak          String?
  golonganDarah       String?
  fotoProfil          String?
  alamat              String?
  kategoriSkrining    String?  @default("Risiko Rendah")
  sudahSkrining       Boolean  @default(false)
  skorSkrining        Int?
  usiaKehamilanUpdatedAt DateTime @default(now())
}

model KeluhanLog {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tanggal          DateTime  @default(now())
  daftarKeluhan    String[]
  tingkatKeparahan Keparahan
  isRedFlag        Boolean   @default(false)
  catatanBebas     String?
}

model OtpVerification {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kode            String
  expiredAt       DateTime
  jumlahPercobaan Int      @default(0)
}

model Post {
  id         String    @id @default(uuid())
  authorId   String
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isiPost    String
  tag        String
  reportedBy String[]  @default([])
  createdAt  DateTime  @default(now())
  comments   Comment[]
  likes      Like[]
}

model Comment {
  id          String   @id @default(uuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isiKomentar String
  reportedBy  String[] @default([])
  createdAt   DateTime @default(now())
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

enum RiskCategory {
  RENDAH
  SEDANG
  TINGGI
}

model MasterTodo {
  id                String       @id @default(uuid())
  bulan             Int          // 1 s.d. 9
  trimester         String       // e.g. "Trimester 1"
  kategoriRisiko    RiskCategory
  hariKe            Int          // 1 s.d. 7 (Siklus Harian)
  noTugas           Int          // 1 s.d. 5 (5 tugas per hari)
  tugasHarian       String
  kategoriAktivitas String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  userTodos         UserTodo[]

  @@unique([bulan, kategoriRisiko, hariKe, noTugas])
}

model UserTodo {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  masterTodoId String
  masterTodo   MasterTodo @relation(fields: [masterTodoId], references: [id], onDelete: Cascade)
  tanggal      DateTime   // Menyimpan tanggal (Y-M-D) tanpa jam
  isCompleted  Boolean    @default(false)
  completedAt  DateTime?
  createdAt    DateTime   @default(now())

  @@unique([userId, masterTodoId, tanggal])
}

enum SubscriptionPlan {
  BASIC
  PRO
  PREMIUM
  PREMIUM_LENGKAP
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String             @unique
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId, status, endDate])
}

enum OrderStatus {
  BELUM_BAYAR
  DIKEMAS
  DIKIRIM
  SELESAI
  DIBATALKAN
}

model Order {
  id               String      @id @default(uuid())
  orderNumber      String      @unique
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           OrderStatus @default(BELUM_BAYAR)
  
  // Data Pembelian
  items            Json        // Array produk [{id, name, price, quantity, image, description}]
  totalPrice       Float       // Total keseluruhan (subtotal + shippingFee)
  subtotal         Float       // Total belanja produk
  shippingFee      Float       // Biaya ongkos kirim
  courierName      String?     // Nama kurir & layanan
  paymentMethod    String      // 'qris' | 'bank' | 'cod'
  bankName         String?     // 'BCA' | 'Mandiri' | dll
  vaNumber         String?     // Nomor Virtual Account jika bank
  shippingAddress  String?     // Alamat lengkap penerima
  
  // Timestamp lifecycle untuk evaluasi status dan countdown
  createdAt        DateTime    @default(now())
  paymentDeadline  DateTime    // createdAt + 24 jam (1 hari)
  paidAt           DateTime?   // waktu saat pembayaran berhasil
  packedAt         DateTime?   // waktu saat masuk status DIKEMAS
  packedDeadline   DateTime?   // packedAt + 30 menit
  shippedAt        DateTime?   // waktu saat masuk status DIKIRIM
  shippingDeadline DateTime?   // shippedAt + 24 jam (1 hari)
  completedAt      DateTime?   // waktu saat status SELESAI
  updatedAt        DateTime    @updatedAt

  @@index([userId, status])
}

